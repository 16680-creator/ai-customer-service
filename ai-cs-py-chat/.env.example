# ===== LLM 配置(OpenAI 兼容协议,默认 DeepSeek)=====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-api-key
LLM_MODEL=deepseek-chat

# 切换硅基流动(Qwen)示例:
# LLM_BASE_URL=https://api.siliconflow.cn
# LLM_API_KEY=sk-your-siliconflow-api-key
# LLM_MODEL=Qwen/Qwen3-8B

# 生成参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ===== 应用配置 =====
APP_HOST=0.0.0.0
APP_PORT=8000
# 允许跨域的前端来源,逗号分隔;* 表示全部放开(仅建议开发环境)
CORS_ORIGINS=*

# 系统提示词
SYSTEM_PROMPT=你是一个乐于助人的 AI 助手,请用简洁的中文回答。
