# ============== 服务配置 ==============
APP_HOST=0.0.0.0
APP_PORT=8082
CORS_ORIGINS=*

# ============== Nacos 配置 ==============
NACOS_HOSTS=localhost:8848
NACOS_NAMESPACE=ai-customer-service
SERVICE_NAME=ai-cs-py-recommend

# ============== Redis 配置 ==============
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
CACHE_TTL=3600

# ============== 下游服务 ==============
PRODUCT_SERVICE_URL=http://localhost:8085
ORDER_SERVICE_URL=http://localhost:8086

# ============== 推荐算法参数 ==============
RECOMMEND_LIMIT=5
SIMILAR_PRODUCTS_LIMIT=10
USER_HISTORY_LIMIT=20

# ============== 可观测性 ==============
LOG_LEVEL=INFO
JAEGER_HOST=localhost
JAEGER_PORT=6831
